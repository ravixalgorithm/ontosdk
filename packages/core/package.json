{
  "name": "@ontosdk/core",
  "version": "0.1.1",
  "description": "Shared HTML→Markdown cleaning + AIO scoring engine. Powers @ontosdk/next, the Onto Read API, and the AIO scanner.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./clean": {
      "types": "./dist/clean.d.ts",
      "import": "./dist/clean.mjs",
      "require": "./dist/clean.js"
    },
    "./score": {
      "types": "./dist/score.d.ts",
      "import": "./dist/score.mjs",
      "require": "./dist/score.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node test/verify-tables.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "markdown",
    "html-to-markdown",
    "aio",
    "agent-input-optimization",
    "llm",
    "scoring",
    "extraction",
    "onto"
  ],
  "author": "Onto",
  "license": "MIT",
  "homepage": "https://buildonto.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/onto-buildonto/onto-sdk.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/onto-buildonto/onto-sdk/issues"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "turndown": "^7.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/turndown": "^5.0.4",
    "tsup": "^8.0.2",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.3.3"
  }
}
