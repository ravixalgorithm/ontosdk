{
    "name": "@ontosdk/next",
    "version": "1.6.7",
    "description": "Extracts semantic Markdown from React/Next.js pages for AI Agents",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./middleware": {
            "types": "./dist/middleware.d.ts",
            "import": "./dist/middleware.mjs",
            "require": "./dist/middleware.js"
        },
        "./components": {
            "types": "./dist/OntoHead.d.ts",
            "import": "./dist/OntoHead.mjs",
            "require": "./dist/OntoHead.js"
        },
        "./provider": {
            "types": "./dist/OntoProvider.d.ts",
            "import": "./dist/OntoProvider.mjs",
            "require": "./dist/OntoProvider.js"
        },
        "./config": {
            "types": "./dist/config.d.ts",
            "import": "./dist/config.mjs",
            "require": "./dist/config.js"
        }
    },
    "typesVersions": {
        "*": {
            "middleware": [
                "dist/middleware.d.ts"
            ],
            "components": [
                "dist/OntoHead.d.ts"
            ],
            "provider": [
                "dist/OntoProvider.d.ts"
            ],
            "config": [
                "dist/config.d.ts"
            ]
        }
    },
    "bin": {
        "onto-next": "dist/cli.js"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "keywords": [
        "nextjs",
        "ai",
        "markdown",
        "extraction",
        "seo"
    ],
    "author": "Onto",
    "license": "MIT",
    "dependencies": {
        "@ontosdk/core": "^0.1.0",
        "cheerio": "^1.0.0-rc.12",
        "glob": "^10.3.10",
        "picocolors": "^1.0.0",
        "turndown": "^7.1.3"
    },
    "peerDependencies": {
        "next": ">=14.0.0",
        "react": "^18.0.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "^20.11.24",
        "@types/react": "^19.2.14",
        "@types/turndown": "^5.0.4",
        "next": "^16.1.6",
        "react": "^19.2.4",
        "tsup": "^8.0.2",
        "typescript": "^5.3.3"
    }
}
